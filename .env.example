# ==============================================
# BACKEND CONFIGURATION
# ==============================================

# Server Configuration
BACKEND_PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/photo-gallery

# JWT Secret (change this to a secure random string in production)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Session Secret (for OAuth)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production

# OAuth - Google
# Get these from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# OAuth - GitHub
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your-github-client-id-here
GITHUB_CLIENT_SECRET=your-github-client-secret-here

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=uploads/photos

# Root Admin Email (password auto-generated on first start)
ROOT_ADMIN_EMAIL=admin@photogallery.local

# ==============================================
# APPLICATION URLS (Simplified Configuration)
# ==============================================
# Change these to your FQDN (Fully Qualified Domain Name) for production
# 
# Examples for localhost (development):
#   APP_URL=http://localhost:3001
#   APP_URL_BACKEND=http://localhost:5000
#   APP_URL_AUTH=http://localhost:3001
#
# Examples for production with FQDN:
#   APP_URL=https://photos.yourdomain.com
#   APP_URL_BACKEND=https://api.yourdomain.com
#   APP_URL_AUTH=https://photos.yourdomain.com
#
# Examples with IP:
#   APP_URL=http://192.168.1.100:3001
#   APP_URL_BACKEND=http://192.168.1.100:5000
#   APP_URL_AUTH=http://192.168.1.100:3001

# Frontend URL (where users access the site)
APP_URL=http://localhost:3001

# Frontend API URL (must be NEXT_PUBLIC_ for Next.js)
NEXT_PUBLIC_APP_URL_BACKEND=http://localhost:5000

# Backend API URL (where frontend calls the API - no /api suffix)
APP_URL_BACKEND=http://localhost:5000

# Auth URL (for NextAuth and OAuth callbacks - usually same as APP_URL)
APP_URL_AUTH=http://localhost:3001

# ==============================================
# FRONTEND CONFIGURATION
# ==============================================

# Frontend Port (for development)
FRONTEND_PORT=3001

# Site Configuration
NEXT_PUBLIC_SITE_NAME=Photo Gallery
NEXT_PUBLIC_SITE_DESCRIPTION=A beautiful photo gallery
